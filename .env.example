# Wzór pliku `.env` dla serwera. Skopiuj i uzupełnij NA SERWERZE:
#
#     cp .env.example .env && nano .env && chmod 600 .env
#
# Plik `.env` jest w .gitignore i ma tam zostać. Wartości poniżej to wzór,
# nie sekrety — prawdziwych nie wolno wpisać do repozytorium.

# ------------------------------------------------------------- obowiązkowe

# Podpisuje ciastko sesji (u nas: komunikaty „flash”, bo logowania nie ma).
# Domyślna wartość w kodzie („rspo-narzedzie”) leży na GitHubie. Wygeneruj
# własną NA SERWERZE:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ------------------------------------------------------------- na przyszłość

# Dane do API rejestru (api.rspo.gov.pl, HTTP Basic Auth). Wniosek do CIE nie
# jest jeszcze wysłany — patrz tmp/API_RSPO_notatki.md. Gdy przyjdą, wpisz je
# TUTAJ, nigdy w kodzie: `api.py` ma je czytać z os.environ.
#RSPO_API_LOGIN=
#RSPO_API_HASLO=

# ------------------------------------------------------------- czego tu NIE ma

# PIN-u ani hasła do aplikacji — RSPO nie ma własnego logowania (świadomie,
# patrz CLAUDE.md §5). Na serwerze dostępu pilnuje nginx (Basic Auth,
# /etc/nginx/.htpasswd-rspo) — patrz docs/WDROZENIE.md, punkt 5.
# Gdyby kiedyś doszedł mechanizm PIN-ów z aplikacji leadów, jego sekrety
# trafią tutaj, a wpis w nginx pójdzie do kosza.
